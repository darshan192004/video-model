      "dot": "cyan",
      "title": "Fast Acceptance",
      "items": [
        "The request is acknowledged before render starts",
        "The queue owns the work, not the long-lived connection",
        "No model weight loads until dequeue"
      ]
    },
    {
      "dot": "orange",
      "title": "Serial Render",
      "items": [
        "One GPU serves every job in arrival order",
        "Load, denoise and decode happen once per job",
        "Completed media is written to the local store"
      ]
    },
    {
      "dot": "emerald",
      "title": "Two Observation Paths",
