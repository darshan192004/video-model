      "class_type": "SmokeNode",
      "inputs": {}
    }
  },
  "t2v": {
    "3": {
      "class_type": "CLIPLoader",
      "inputs": {
        "clip_name": "wan_2.2_14b.gguf",
        "type": "wan"
      }
    },
    "4": {
      "class_type": "VAELoader",
      "inputs": {
        "vae_name": "wan_2.2_vae.gguf"
      }
    },
