        "seed": "{{ seed }}",
        "steps": "{{ steps }}",
        "cfg": "{{ guidance }}",
        "start_image": null
      }
    },
    "17": {
      "class_type": "SaveVideo",
      "inputs": {
        "images": ["16", 0],
        "filename_prefix": "wan/t2v"
      }
    }
  },
  "i2v": {
