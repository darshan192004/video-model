# Copy to `secrets.env`, fill in, chmod 600 (gitignored). These feed the
# app-secrets secretGenerator (envs: secrets.env), which control-plane + worker
# consume via envFrom; DATABASE_URL is assembled from the POSTGRES_* triple.
# OIDC_CLIENT_SECRET must match the Dex staticClients[media-controlplane].secret
# in config-dex.yaml (the dev overlay's test Dex uses `test-secret`).
# Generate values with:  openssl rand -hex 32  |  openssl rand -hex 24
OIDC_CLIENT_SECRET=test-secret
SESSION_SECRET=
POSTGRES_PASSWORD=
POSTGRES_USER=media
POSTGRES_DB=media