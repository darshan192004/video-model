# --- ComfyUI service configuration ---
# COMFY_MODE=gpu runs CUDA; COMFY_MODE=cpu forces --cpu (dev box smoke only).
# Copy to system/.env and edit.
COMFY_MODE=gpu
COMFY_LISTEN=0.0.0.0
COMFY_PORT=8188
# Optional VRAM strategy: leave empty for auto, or set lowvram|gpu-only
COMFY_VRAM=lowvram
# Extra CLI flags forwarded verbatim (e.g. --cpu-vae for VAE on CPU RAM).
# Used by the GPU override on the 3090 box; empty on the dev box.
COMFY_EXTRA_ARGS=
# Absolute path on the host containing the user's model weights tree.
# link-models.sh (Phase 3) maps it into ComfyUI/models layout.
MODELS_PATH=/srv/media-weights
# Phase 3: point LINKED_MODELS at the symlink forest produced by link-models.sh
# (system/models) so compose mounts exactly the manifested layout. Unset links
# MODELS_PATH directly.
#LINKED_MODELS=/path/to/system/models
#LINKED_DEST=/opt/ComfyUI/models
# nginx hostname / ServerName SNI used by gen-certs.sh (Phase 1).
DOMAIN=media.local
HTTPS_PORT=443

# --- Control-plane (FastAPI) ---
# Full env contract lives in system/controlplane/app/settings.py; every value
# below is a placeholder. Secrets are never committed for real.
CONTROLPLANE_LISTEN=0.0.0.0
CONTROLPLANE_PORT=8000
# OIDC issuer from the org's existing Dex (FreeIPA-backed). In dev compose/k3s
# this points at the dev test Dex, reachable from BOTH the control-plane pod and
# the test host (P1.5 reachability contract); on the 3090 box it is the real org issuer.
DEX_OIDC_ISSUER=http://host.docker.internal:5556/dex
OIDC_CLIENT_ID=media-controlplane
# Placeholder: replace with the client secret registered at the issuer. The
# control-plane refuses to start when OIDC_MOCK=0 and this trio is incomplete.
OIDC_CLIENT_SECRET=change-me
OIDC_REDIRECT_URI=https://media.local/api/auth/callback
# Comma-separated FreeIPA group names whose members are admins (via Dex 'groups' claim).
ADMIN_GROUPS=media-admins
# Fallback admin group used when ADMIN_GROUPS is empty.
DEFAULT_ADMIN_GROUPS=media-admins
# Signs the media_sid cookie. Placeholder: generate with `openssl rand -hex 32`.
SESSION_SECRET=change-me
# OIDC_MOCK=1 swaps the issuer for an in-app handler that mints an identity from
# /api/auth/start?email=... ; unit tests only, never production.
OIDC_MOCK=0
# ComfyUI is reachable only inside the internal network:
COMFY_INTERNAL_URL=http://comfyui:8188
# psycopg3 async driver: the URL must carry the +psycopg dialect suffix.
DATABASE_URL=postgresql+psycopg://media:media@postgres:5432/media
GALLERY_ROOT=/data/galleries
UPLOAD_ROOT=/data/uploads
# Create the schema (SQLAlchemy metadata) at boot; set 0 when migrations are
# managed out of band.
AUTO_MIGRATE=1
# Directory holding the built SPA (index.html + assets); baked to /opt/media/spa.
SPA_STATIC=/opt/media/spa

# --- Worker (FIFO job consumer) ---
# ComfyUI's scratch output volume, read by the worker for gallery copy. Inside
# compose this is the shared `comfy-output` named volume.
COMFY_OUTPUT_DIR=/data/comfy-output
# ComfyUI's input volume, where the worker stages {PARAM.image} uploads.
COMFY_INPUT_DIR=/data/comfy-input
# Poll cadence (s) and per-job execution budget (s) when driving ComfyUI.
WORKER_POLL_SECONDS=2
WORKER_JOB_TIMEOUT_SECONDS=3600

# --- Phase 2 workflows + schema (read-only mounts) ---
# Canonical API-format graphs (system/workflows/*.json) and the keyed template
# schema (system/config/templates.schema.json), mounted :ro at these paths.
WORKFLOWS_DIR=/opt/media/workflows
TEMPLATE_SCHEMA=/opt/media/config/templates.schema.json
# Test/dev-only: directory of extra *isolated* template fixtures (e.g. the
# deliberately broken-template.json load-tested by tests/smoke.sh). Unset in
# production — the API then serves exactly the keyed schema.
TEMPLATE_FIXTURES_DIR=

# --- Phase 3 smoke identities (test Dex) ---
# tests/smoke.sh logs in as two identities; these pair with the staticPasswords
# in deploy/dex/config.yaml. Only meaningful when OIDC_MOCK=0.
DEX_USER_ADMIN=admin@test
DEX_PASS_ADMIN=adminpass
DEX_USER_PLAIN=user@test
DEX_PASS_PLAIN=userpass

# --- Postgres ---
POSTGRES_DB=media
POSTGRES_USER=media
# Dev-box default only; production supplies this through a Secret.
POSTGRES_PASSWORD=media
